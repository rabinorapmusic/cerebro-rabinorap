"""
CEREBRO OMEGA
Motor de Generación de Posibilidades
"""

from dataclasses import dataclass
import random


@dataclass
class Possibility:
    idea: str
    generation: int = 0
    score: float = 0.0


class GenerationEngine:
    """Genera posibilidades a partir de un objetivo."""

    def __init__(self, seed=None):
        self.random = random.Random(seed)

    def generate(self, objective: str, amount: int = 10):
        if not objective.strip():
            raise ValueError("El objetivo no puede estar vacío.")

        patterns = [
            "Resolver {x} de una forma simple.",
            "Resolver {x} de una forma innovadora.",
            "Resolver {x} mediante una estrategia alternativa.",
            "Resolver {x} utilizando automatización.",
            "Resolver {x} dividiéndolo en pequeños problemas.",
            "Resolver {x} combinando diferentes métodos.",
            "Resolver {x} mediante experimentación.",
            "Resolver {x} buscando una solución completamente diferente.",
        ]

        results = []

        for _ in range(max(1, amount)):
            pattern = self.random.choice(patterns)

            results.append(
                Possibility(
                    idea=pattern.format(x=objective)
                )
            )

        return results(
